{
  "name": "qadrahr-mobile",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "private": true,
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.15",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.19",
    "lucide-react-native": "^1.34.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.9",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:device:ios": "eas build --profile device --platform ios",
    "build:device:android": "eas build --profile device --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform all",
    "build:list": "eas build:list --limit 10",
    "eas:config": "eas config --profile device --platform ios",
    "eas:whoami": "eas whoami",
    "submit:prod": "eas submit --profile production --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "doctor": "npx expo-doctor@latest",
    "deps:check": "expo install --check",
    "clean": "rm -rf .expo node_modules/.cache && watchman watch-del-all 2>/dev/null || true",
    "test": "jest",
    "gen:api": "node scripts/generate-api.mjs",
    "icons": "sh scripts/render-icons.sh"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "react-dom": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  }
}
